{
  "name": "@agent-autoloop/feishu-a2ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "*.mjs",
    "*.d.mts"
  ],
  "exports": {
    ".": {
      "types": "./ui.d.mts",
      "default": "./ui.mjs"
    },
    "./avatars": {
      "types": "./avatars.d.mts",
      "default": "./avatars.mjs"
    },
    "./avatar-url": {
      "types": "./avatar-url.d.mts",
      "default": "./avatar-url.mjs"
    },
    "./cli": {
      "types": "./cli.d.mts",
      "default": "./cli.mjs"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0"
  }
}
